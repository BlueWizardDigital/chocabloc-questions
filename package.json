{
  "name": "chocabloc-questions",
  "version": "0.6.0-beta.3",
  "description": "Framework-agnostic question data + renderers for ChocaBLOC iframe games",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com:BlueWizardDigital/chocabloc-questions.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./helpers": {
      "types": "./dist/helpers-only.d.ts",
      "import": "./dist/helpers-only.mjs",
      "require": "./dist/helpers-only.cjs"
    },
    "./full": {
      "types": "./dist/full.d.ts",
      "import": "./dist/full.mjs",
      "require": "./dist/full.cjs"
    },
    "./elements/coin-pile": {
      "types": "./dist/elements/coin-pile.d.ts",
      "import": "./dist/elements/coin-pile.mjs"
    },
    "./elements/whiteboard": {
      "types": "./dist/elements/whiteboard.d.ts",
      "import": "./dist/elements/whiteboard.mjs"
    },
    "./bridge": {
      "types": "./dist/bridge.d.ts",
      "import": "./dist/bridge.mjs",
      "require": "./dist/bridge.cjs"
    }
  },
  "sideEffects": [
    "./dist/full.mjs",
    "./dist/full.cjs",
    "./dist/elements/coin-pile.mjs",
    "./dist/elements/canvas-question.mjs",
    "./dist/elements/whiteboard.mjs",
    "./dist/chunks/ChocaWhiteboard.*.mjs",
    "./dist/bridge.mjs",
    "./dist/bridge.cjs"
  ],
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "PARTS-AND-VARS.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build",
    "build:watch": "vite build --watch",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "wtr",
    "lint": "eslint src tests --ext .ts",
    "lint:fix": "eslint src tests --ext .ts --fix",
    "format": "prettier --write src tests",
    "size": "size-limit",
    "typecheck": "tsc --noEmit",
    "ci": "npm run typecheck && npm run lint && npm run test && npm run build && npm run size"
  },
  "devDependencies": {
    "@esm-bundle/chai": "^4.3.4-fix.0",
    "@size-limit/file": "^11.1.0",
    "@size-limit/preset-small-lib": "^11.1.0",
    "@types/chai": "^5.2.3",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitest/coverage-v8": "^1.6.1",
    "@web/dev-server-esbuild": "^1.0.5",
    "@web/test-runner": "^0.18.0",
    "@web/test-runner-playwright": "^0.11.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.2.0",
    "size-limit": "^11.1.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vite-plugin-dts": "^5.0.0",
    "vitest": "^1.4.0"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
