  "skillId": "COMPARE-NUMBERS-WITHIN-100",
  "title": "Compare numbers to 100",
  "idea": {
    "heading": "Meet the signs",
    "text": "These signs show how two numbers compare.",
    "cards": [
      {
        "big": "<",
        "words": "is less than",
        "example": "3 < 8"
      },
      {
        "big": ">",
        "words": "is greater than",
        "example": "8 > 3"
      },
      {
        "big": "=",
        "words": "is equal to",
        "example": "5 = 5"
      }
    ],
    "tip": "The pointy end points at the smaller number."
  },
  "example": {
    "operands": [
      43,
      52
    ],
    "steps": [
      {
        "heading": "Let's compare 43 and 52.",
        "text": "Each tall stick is a ten. Each little cube is a one.",
        "picture": {
          "kind": "base10",
          "numbers": [
            43,
            52
          ]
        }
      },
      {
        "heading": "Count the tens first.",
        "text": "43 has 4 tens. 52 has 5 tens.",
        "picture": {
          "kind": "base10",
          "numbers": [
            43,
            52
          ],
          "focus": "tens"
        }
      },
      {
        "heading": "4 tens is less than 5 tens.",
        "text": "When the tens are different, the tens decide.",
        "picture": {
          "kind": "base10",
          "numbers": [
            43,
            52
          ],
          "focus": "tens"
        }
      },
      {
        "heading": "So 43 is less than 52.",
        "text": "The pointy end points at the smaller number.",
        "result": "43 < 52"
      }
    ]
  },
  "afterWrong": {
    "tip": "Count the tens first. If the tens match, look at the ones.",
    "picture": {
      "kind": "base10",
      "from": "operands"
    }
  },
